# Supabase Dashboard -> Connect -> Session pooler (recommended for most local IPv4 networks)
# Example format:
# postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
